{
  "mcpServers": {
    "serper": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-serper"
      ],
      "env": {
        "SERPER_API_KEY": ""
      }
    },
    "fetch": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-fetch"
      ]
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {}
    },
    "cua-driver": {
      "command": "cua-driver",
      "args": [
        "mcp"
      ]
    }
  }
}